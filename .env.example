# Copiar a .env y completar. NUNCA subir .env al repositorio.

# --- Telegram (avisos y comandos) ---
# 1. En Telegram habla con @BotFather → /newbot → copia el token aquí
# 2. Escríbele /start a tu bot y corre: uv run btcbot telegram chat-id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Binance (solo para operar con dinero real, fase 7; NO hace falta para paper trading) ---
# Crear la clave SIN permiso de retiro y restringida por IP.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Web de seguimiento ---
# Se generan con: uv run btcbot web set-password  (guarda solo el hash)
WEB_PASSWORD_HASH=
WEB_SESSION_SECRET=
# En el servidor con HTTPS (Caddy): ambos en 1
WEB_SECURE_COOKIES=0
WEB_TRUST_PROXY=0
